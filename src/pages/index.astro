const darkMonochromeIcons = new Set([
	"/tools/apple-iwork.svg",
	"/tools/chatgpt.svg",
	"/tools/cursor.svg",
	"/tools/flask.svg",
	"/tools/github.svg",
	"/tools/grok.svg",
	"/tools/markdown.svg",
	"/tools/notion.svg",
	"/tools/x.svg",
