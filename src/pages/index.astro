---
import PageLayout from "@/layouts/Base.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getEntry } from "astro:content";
import PublicationItem from "@/components/PublicationItem.astro";
import PublicationScripts from "@/components/PublicationScripts.astro";
import { findAssetByName, resolveAsset } from "@/utils/assets";
import figureImage from "../assets/figure.jpg";

// =========================
// EDITABLE CONTENT (edit here)
// =========================

type PublicationEditable = {
	author: string[];
	title: string;
	booktitle: string;
	time?: string;
	doi?: string;
	paper?: string;
	code?: string;
	huggingface?: string;
	site?: string;
	venueIcon?: string;
	venueColor?: string;
	venueRank?: string;
	venueLogo?: string;
	abstract?: string;
	selected?: boolean;
	semantic_scholar_id?: string;
};

type PublicationResolved = Omit<PublicationEditable, "venueLogo"> & {
	venueLogo: ImageMetadata | null;
};

type NewsItem = {
	date: string;
	html?: string;
	text?: string;
	href?: string;
	label?: string;
};

type ProjectEditable = {
	name: string;
	description: string;
	tags?: string[];
	time?: string;
	repo?: string;
	site?: string;
	paper?: string;
	orgLogos?: string[];
};

type AckPerson = { name: string; href: string };
type Acknowledgements = {
	title: string;
	introLines?: string[];
	mentors?: AckPerson[];
	peersIntro?: string;
	peers?: AckPerson[];
	outro?: string;
};

type AcademicService = {
	role: string;
	venue: string;
	venueLink?: string;
	year: string;
};

type HonorItem = {
	title: string;
	issuer: string;
	date: string;
};

// =========================
// Content loading (YAML-driven data)
// =========================

// Load editable content from YAML (src/content/home/index.yaml)
const homeEntry = await getEntry("home", "index");
if (!homeEntry) throw new Error("Missing content entry: src/content/home/index.yaml");

const publicationsEditable = homeEntry.data.publicationsEditable as PublicationEditable[];
const newsItems = homeEntry.data.newsItems as NewsItem[];
const projectsEditable = homeEntry.data.projectsEditable as ProjectEditable[];
const experienceMeta = (homeEntry.data.experienceMeta ?? {}) as Record<
	string,
	{ name: string; link: string }
>;
const homeIntroHtml = (homeEntry.data.homeIntroHtml ?? "") as string;
const callout = (homeEntry.data.callout ?? "") as string;
const acknowledgements = (homeEntry.data.acknowledgements ?? null) as Acknowledgements | null;
const personalPhilosophyHtml = (homeEntry.data.personalPhilosophyHtml ?? "") as string;
const academicServices = (homeEntry.data.academicServices ?? []) as AcademicService[];
const honors = (homeEntry.data.honors ?? []) as HonorItem[];

// =========================
// Helpers (pure utilities)
// =========================

function escapeHtml(s: string) {
	return s
		.replaceAll("&", "&amp;")
		.replaceAll("<", "&lt;")
		.replaceAll(">", "&gt;")
		.replaceAll('"', "&quot;")
		.replaceAll("'", "&#039;");
}

function repoLabel(url: string): string {
	try {
		const u = new URL(url);
		const host = u.hostname.toLowerCase();
		if (host === "github.com" || host.endsWith(".github.com")) {
			return u.pathname.replace(/^\/+|\/+$/g, "");
		}
		return url;
	} catch {
		return url;
	}
}

// =========================
// Asset resolution (images/logos)
// =========================

// =========================
// Derived data (publications/projects/experiences/logos)
// =========================

const cactusTech: PublicationResolved[] = publicationsEditable
	.map((pub) => {
		const vlogo = resolveAsset(pub.venueLogo);
		return { ...pub, venueLogo: vlogo };
	})
	.filter((p) => p.selected === true);

const projects = projectsEditable;

// Experiences (auto logos from /assets/exps)
const expImages = import.meta.glob<ImageMetadata>("../assets/exps/*.{png,jpg,jpeg,svg,webp}", {
	eager: true,
	import: "default",
});

function expNumericOrder(file: string): number | null {
	const m = file.match(/^exp(\d+)\./i);
	return m ? Number(m[1]) : null;
}

function fileStem(file: string): string {
	return file.replace(/\.[^.]+$/, "");
}

function getExperienceMeta(file: string): { name: string; link: string } {
	const stem = fileStem(file);
	const meta =
		experienceMeta[file] ||
		experienceMeta[stem] ||
		experienceMeta[file.toLowerCase()] ||
		experienceMeta[stem.toLowerCase()];
	if (!meta) throw new Error(`Missing experienceMeta entry for ${file}`);
	return meta;
}

const experiences = Object.entries(expImages)
	.map(([path, image]) => {
		const file = path.split("/").pop() || "";
		const meta = getExperienceMeta(file);
		const altTitleName = meta.name.replace(/\s*\n\s*/g, " ");
		const tooltipHtml = escapeHtml(meta.name).replaceAll("\n", "<br/>");
		return { file, image, name: meta.name, altTitleName, tooltipHtml, link: meta.link };
	})
	.sort((a, b) => {
		const an = expNumericOrder(a.file);
		const bn = expNumericOrder(b.file);
		if (an != null && bn != null) return bn - an;
		if (an != null) return -1;
		if (bn != null) return 1;
		return a.file.localeCompare(b.file);
	});

const LOGO_ALIASES: Record<string, string[]> = {
	whu: ["whu", "wuhan"],
};

const projectLogoKeys = new Set<string>(projectsEditable.flatMap((p) => p.orgLogos ?? []));

const projectLogoByKey: Record<string, ImageMetadata | null> = Object.fromEntries(
	[...projectLogoKeys].map((k) => [k, findAssetByName(LOGO_ALIASES[k] ?? k)]),
);

const homeIntroLeadMatch = homeIntroHtml.match(/^\s*<p>([\s\S]*?)<\/p>\s*/);
const homeIntroLeadText = homeIntroLeadMatch ? homeIntroLeadMatch[1].trim() : "";
const homeIntroBodyHtml = homeIntroLeadMatch
	? homeIntroHtml.slice(homeIntroLeadMatch[0].length)
	: homeIntroHtml;
const HONORS_PREVIEW_COUNT = 5;
const honorsPreview = honors.slice(0, HONORS_PREVIEW_COUNT);
const honorsRest = honors.slice(HONORS_PREVIEW_COUNT);

const NEWS_PREVIEW_COUNT = 5;
const newsPreview = newsItems.slice(0, NEWS_PREVIEW_COUNT);
const newsRest = newsItems.slice(NEWS_PREVIEW_COUNT);
---

<PageLayout meta={{ title: "Home" }}>
	<section id="intro" class="rounded-2xl pr-6 pb-6">
		{homeIntroLeadText && <h1 class="hero-title">{homeIntroLeadText}</h1>}
		<figure class="profile-figure">
			<Image
				src={figureImage}
				alt="Xu Pan"
				width={320}
				sizes="(min-width: 1180px) 18vw, 220px"
				densities={[1, 2]}
				loading="eager"
				fetchpriority="high"
			/>
			<figcaption>Fig. 1. Taken before graduation, 2026.</figcaption>
		</figure>
		{
			homeIntroBodyHtml.trim() && (
				<div class="rich-content space-y-3">
					<Fragment set:html={homeIntroBodyHtml} />
				</div>
			)
		}
	</section>

	{
		callout.trim() ? (
			<aside class="home-callout" aria-label="Current status">
				<div class="home-callout__content" set:html={callout} />
			</aside>
		) : null
	}

	<section id="news" class="mt-8 rounded-2xl pr-6 pb-6" aria-label="News">
		<h2 class="title mb-3 text-xl">News</h2>
		<ul class="news-list">
			{
				newsPreview.map((item) => (
					<li class="news-item">
						<span class="news-item__date">{item.date}</span>

						<div class="min-w-0 text-gray-700 dark:text-gray-300">
							{item.html ? (
								// NOTE: html is rendered as-is; only put trusted content here
								<span set:html={item.html} />
							) : (
								<>
									{item.text && <span set:html={escapeHtml(item.text)} />}
									{item.href && (
										<>
											{" "}
											<a class="cactus-link" href={item.href} target="_blank" rel="noopener">
												{item.label ?? "More"}
											</a>
										</>
									)}
								</>
							)}
						</div>
					</li>
				))
			}
		</ul>

		{
			newsRest.length > 0 ? (
				<details class="group">
					<summary class="ui-control mx-auto flex w-fit cursor-pointer list-none items-center px-3 py-2">
						<span>SHOW {newsRest.length} MORE</span>
						<Icon
							name="lucide:chevron-down"
							class="ml-1 h-3.5 w-3.5 transition-transform duration-200 group-open:rotate-180"
							aria-hidden="true"
						/>
					</summary>
					<ul class="news-list">
						{newsRest.map((item) => (
							<li class="news-item">
								<span class="news-item__date">{item.date}</span>

								<div class="min-w-0 text-gray-700 dark:text-gray-300">
									{item.html ? (
										<span set:html={item.html} />
									) : (
										<>
											{item.text && <span set:html={escapeHtml(item.text)} />}
											{item.href && (
												<>
													{" "}
													<a class="cactus-link" href={item.href} target="_blank" rel="noopener">
														{item.label ?? "More"}
													</a>
												</>
											)}
										</>
									)}
								</div>
							</li>
						))}
					</ul>
				</details>
			) : null
		}
	</section>

	<section id="experiences" class="mt-8 rounded-2xl pr-6 pb-6" aria-label="Experiences">
		<h2 class="title mb-3 text-xl">Experiences</h2>
		<div class="experience-grid">
			{
				experiences.map((exp) => (
					<a
						href={exp.link}
						target="_blank"
						rel="noopener"
						aria-label={exp.altTitleName}
						class="experience-item group relative flex items-center justify-center"
					>
						<Image
							src={exp.image}
							alt={exp.altTitleName}
							width={256}
							densities={[1, 2]}
							class="experience-logo w-auto object-contain"
							loading="lazy"
						/>
						<span class="experience-tooltip">
							<span set:html={exp.tooltipHtml} />
						</span>
					</a>
				))
			}
		</div>

		{/* Acknowledgements (YAML-driven via acknowledgements) */}
		{
			acknowledgements && (
				<p class="acknowledgements">
					<>
						<b>{acknowledgements.title}</b>
						<br />
					</>

					{acknowledgements.introLines?.map((l) => (
						<>
							{l}
							<br />
						</>
					))}

					{acknowledgements.mentors?.map((p, i) => (
						<>
							<a class="cactus-link" href={p.href}>
								{p.name}
							</a>
							{i < (acknowledgements.mentors?.length ?? 0) - 1 ? "," : ","}
							{i === (acknowledgements.mentors?.length ?? 0) - 1 ? <br /> : " "}
						</>
					))}

					{acknowledgements.peersIntro ? (
						<>
							{acknowledgements.peersIntro}
							<br />
						</>
					) : null}

					{acknowledgements.peers?.map((p, i) => (
						<>
							<a class="cactus-link" href={p.href}>
								{p.name}
							</a>
							{i < (acknowledgements.peers?.length ?? 0) - 1 ? "," : ","}
							{i === (acknowledgements.peers?.length ?? 0) - 1 ? <br /> : " "}
						</>
					))}
					{acknowledgements.outro ? <>{acknowledgements.outro}</> : null}
				</p>
			)
		}
	</section>

	<section id="publications" class="mt-8" aria-label="Publications">
		<div class="mb-3 flex items-center justify-between">
			<h2 class="title text-xl">Selected Publications</h2>
			<a
				href="/publications"
				aria-label="View all publications"
				class="ui-control group flex items-center gap-x-1.5 px-3 py-1.5"
			>
				VIEW ALL {publicationsEditable.length}
				<Icon
					name="lucide:arrow-right"
					class="func-icon h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5"
					aria-hidden="true"
				/>
			</a>
		</div>
		<div class="-mx-3 sm:-mx-4 md:-mx-6">
			<dl class="px-3 sm:px-4 md:px-6">
				{cactusTech.map((pub) => <PublicationItem pub={pub} />)}
			</dl>
		</div>
	</section>
	<section id="projects" class="mt-8" aria-label="Projects">
		<h2 class="title mb-3 text-xl">Projects</h2>

		<div class="-mx-3 sm:-mx-4 md:-mx-6">
			<div class="projects-list px-3 sm:px-4 md:px-6">
				{
					projects.map((p) => (
						<article class="project-item group relative w-full py-4">
							<div class="project-item__meta">{p.time ?? "—"}</div>
							<div class="project-item__content min-w-0">
								<div class="flex flex-wrap items-center gap-2">
									<h3 class="text-lg leading-snug font-semibold tracking-tight">{p.name}</h3>
								</div>

								<p class="mt-2 text-gray-700 dark:text-gray-300">{p.description}</p>

								{p.tags && p.tags.length > 0 && (
									<div class="mt-2 flex flex-wrap gap-2">
										{p.tags.map((t) => (
											<span class="pub-badge">{t}</span>
										))}
									</div>
								)}

								<div
									class="mt-3 flex items-center justify-between gap-3"
									aria-label="Project links"
								>
									<div class="flex min-w-0 flex-wrap gap-2">
										{p.repo && (
											<a
												class="ui-control inline-flex items-center gap-1.5 px-2.5 py-1"
												href={p.repo}
												target="_blank"
												rel="noopener"
												aria-label={`GitHub repo: ${repoLabel(p.repo)}`}
											>
												<Icon
													name="simple-icons:github"
													width="14"
													height="14"
													class="inline-block"
													aria-hidden="true"
												/>
												<span class="truncate">{repoLabel(p.repo)}</span>
											</a>
										)}

										{p.site && (
											<a
												class="ui-control inline-flex items-center px-2.5 py-1"
												href={p.site}
												target="_blank"
												rel="noopener"
												aria-label={`${p.name} project site`}
											>
												SITE
											</a>
										)}
										{p.paper && (
											<a
												class="ui-control inline-flex items-center px-2.5 py-1"
												href={p.paper}
												target="_blank"
												rel="noopener"
												aria-label={`${p.name} paper`}
											>
												PAPER
											</a>
										)}
									</div>

									{p.orgLogos?.length ? (
										<div class="flex shrink-0 items-center">
											{p.orgLogos.map((k) => {
												const src = projectLogoByKey[k];
												return (
													src && (
														<Image
															src={src}
															alt={`${k} logo`}
															width={28}
															densities={[1, 2]}
															loading="lazy"
															class="ml-1 inline h-5 w-auto object-contain opacity-90"
														/>
													)
												);
											})}
										</div>
									) : null}
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section id="honors" class="mt-8 pr-6 pb-6" aria-label="Honors and Awards">
		<h2 class="title mb-3 text-xl">Honors & Awards</h2>

		{
			honors.length > 0 ? (
				<div class="-mx-3 sm:-mx-4 md:-mx-6">
					<ul class="px-3 sm:px-4 md:px-6">
						{honorsPreview.map((honor) => (
							<li class="honor-item">
								<span class="honor-item__date">{honor.date}</span>
								<div class="min-w-0">
									<p class="leading-5 font-medium text-zinc-800 dark:text-zinc-100">
										{honor.title}
									</p>
									<p class="leading-5 text-zinc-500 dark:text-zinc-400">{honor.issuer}</p>
								</div>
							</li>
						))}
					</ul>

					{honorsRest.length > 0 ? (
						<details class="group">
							<summary class="ui-control mx-auto flex w-fit cursor-pointer list-none items-center px-3 py-2">
								<span>SHOW {honorsRest.length} MORE</span>
								<Icon
									name="lucide:chevron-down"
									class="ml-1 h-3.5 w-3.5 transition-transform duration-200 group-open:rotate-180"
									aria-hidden="true"
								/>
							</summary>
							<ul class="px-3 sm:px-4 md:px-6">
								{honorsRest.map((honor) => (
									<li class="honor-item">
										<span class="honor-item__date">{honor.date}</span>
										<div class="min-w-0">
											<p class="leading-5 font-medium text-zinc-800 dark:text-zinc-100">
												{honor.title}
											</p>
											<p class="leading-5 text-zinc-500 dark:text-zinc-400">{honor.issuer}</p>
										</div>
									</li>
								))}
							</ul>
						</details>
					) : null}
				</div>
			) : null
		}
	</section>

	<section id="service" class="mt-8 rounded-2xl pr-6 pb-6" aria-label="Academic Service">
		<h2 class="title mb-3 text-xl">Academic Service</h2>

		{
			academicServices.length > 0 ? (
				<div class="service-list">
					{academicServices.map((service) => (
						<div class="service-item">
							<div class="service-item__year">{service.year}</div>
							<div class="service-item__content">
								<div class="service-item__role">{service.role}</div>
								<div class="service-item__venue">
									{service.venueLink ? (
										<a
											class="cactus-link"
											href={service.venueLink}
											target="_blank"
											rel="noopener"
											aria-label={`${service.venue} - ${service.role}`}
										>
											{service.venue}
										</a>
									) : (
										<span>{service.venue}</span>
									)}
								</div>
							</div>
						</div>
					))}
				</div>
			) : null
		}
	</section>

	{
		personalPhilosophyHtml.trim() ? (
			<section id="philosophy" class="mt-8 rounded-2xl pr-6 pb-6" aria-label="Personal Philosophy">
				<h2 class="title mb-3 text-xl">Personal Philosophy</h2>
				<div class="rich-content">
					<Fragment set:html={personalPhilosophyHtml} />
				</div>
			</section>
		) : null
	}
</PageLayout>
<PublicationScripts />
