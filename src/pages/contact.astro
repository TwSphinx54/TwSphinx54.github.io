---
import PageLayout from "@/layouts/Base.astro";
import SocialList from "@/components/SocialList.astro";
import { Icon } from "astro-icon/components";

const meta = {
	description:
		"Contact — download my resume, get in touch, or schedule a meeting.",
	title: "Contact",
};
---

<PageLayout meta={meta}>
	<section class="relative z-10 max-w-5xl">
		<div class="rounded-2xl pb-6 pr-6">
			<div class="grid gap-x-10 gap-y-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(13rem,0.48fr)] lg:items-start">
				<div class="space-y-4">
					<h1 class="title text-4xl leading-tight sm:text-5xl">Get in touch</h1>
					<p class="max-w-3xl text-base leading-7 text-gray-700 dark:text-gray-300">
						For collaboration, research discussion, internships, job opportunities, or Ph.D.
						inquiries, feel free to reach out by email or schedule a meeting directly.
					</p>

					<div class="mt-6 flex flex-wrap gap-3">
						<a
							class="inline-flex items-center gap-2 rounded-full bg-accent px-4 py-2.5 text-sm font-semibold text-white transition hover:brightness-110"
							href="https://calendar.notion.so/meet/xupan/schedule"
							target="_blank"
							rel="noopener"
							aria-label="Schedule a meeting"
						>
							<Icon name="lucide:calendar-plus" class="h-4 w-4" />
							Schedule a meeting
						</a>
						<a
							class="inline-flex items-center gap-2 rounded-full border border-zinc-300 px-4 py-2.5 text-sm font-semibold text-gray-800 transition hover:border-accent hover:bg-accent/5 dark:border-zinc-700 dark:text-gray-100 dark:hover:bg-accent/10"
							href="mailto:panxurs@whu.edu.cn"
							aria-label="Send email"
						>
							<Icon name="lucide:mail" class="h-4 w-4" />
							Send email
						</a>
					</div>
				</div>

				<div class="self-start pt-2 lg:pt-9">
					<h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-gray-500 dark:text-gray-400">
						Materials
					</h2>
					<div class="mt-3 space-y-0">
					<a
						class="group flex items-center justify-between py-3 text-sm text-gray-700 transition duration-200 hover:translate-x-0.5 hover:text-accent dark:text-gray-300"
						href="https://raw.githubusercontent.com/TwSphinx54/TwSphinx54.github.io/refs/heads/main/public/Resume.pdf"
						target="_blank"
						rel="noopener"
						aria-label="Download Resume English"
					>
						<span class="font-medium text-gray-900 transition duration-200 group-hover:text-accent dark:text-gray-100 dark:group-hover:text-accent">
							Resume (EN)
						</span>
						<Icon
							name="lucide:download"
							class="h-4 w-4 text-gray-400 transition duration-200 group-hover:translate-x-0.5 group-hover:text-accent"
						/>
					</a>
					<a
						class="group flex items-center justify-between border-t border-zinc-200/70 py-3 text-sm text-gray-700 transition duration-200 hover:translate-x-0.5 hover:text-accent dark:border-zinc-800/70 dark:text-gray-300"
						href="https://raw.githubusercontent.com/TwSphinx54/TwSphinx54.github.io/refs/heads/main/public/Resume_zh_CN.pdf"
						target="_blank"
						rel="noopener"
						aria-label="Download Resume Chinese"
					>
						<span class="font-medium text-gray-900 transition duration-200 group-hover:text-accent dark:text-gray-100 dark:group-hover:text-accent">
							Resume (ZH)
						</span>
						<Icon
							name="lucide:download"
							class="h-4 w-4 text-gray-400 transition duration-200 group-hover:translate-x-0.5 group-hover:text-accent"
						/>
					</a>
					<a
						class="group flex items-center justify-between border-t border-zinc-200/70 py-3 text-sm text-gray-700 transition duration-200 hover:translate-x-0.5 hover:text-accent dark:border-zinc-800/70 dark:text-gray-300"
						href="https://linkedin.com/in/x-pan"
						target="_blank"
						rel="noopener"
						aria-label="LinkedIn profile"
					>
						<span class="font-medium text-gray-900 transition duration-200 group-hover:text-accent dark:text-gray-100 dark:group-hover:text-accent">
							LinkedIn
						</span>
						<Icon
							name="simple-icons:linkedin"
							class="h-4 w-4 text-gray-400 transition duration-200 group-hover:translate-x-0.5 group-hover:text-accent"
						/>
					</a>
					</div>
				</div>
			</div>
		</div>

		<div class="mt-8">
			<SocialList />
		</div>
	</section>
</PageLayout>
