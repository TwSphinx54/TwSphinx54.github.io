---
import PageLayout from "@/layouts/Base.astro";
import { Icon } from "astro-icon/components";

const meta = {
	description: "Contact — download my resume, get in touch, or schedule a meeting.",
	title: "Contact",
};
const ntuMapUrl =
	"https://use.mazemap.com/?utm_medium=longurl#v=1&config=ntu-sg&zlevel=-2&center=103.680922,1.343206&zoom=17.5&campusid=2123&sharepoitype=poi&sharepoi=1003281510&sharemode=false&positioning=disabled";
const ntuMapPage =
	"https://maps.ntu.edu.sg/?mazemap_share_url=https%3A%2F%2Fuse.mazemap.com%2F%3Futm_medium%3Dlongurl%23v%3D1%26config%3Dntu-sg%26zlevel%3D-2%26center%3D103.680922%2C1.343206%26zoom%3D19.7%26campusid%3D2123%26sharepoitype%3Dpoi%26sharepoi%3D1003281510";
---

<PageLayout meta={meta}>
	<section id="contact">
		<h1 class="title">Get in touch</h1>
		<div class="contact-intro">
			<p>
				For collaboration, research discussion, internships, job opportunities, or Ph.D. inquiries,
				feel free to reach out by email or schedule a meeting directly.
			</p>
			<div class="contact-actions">
				<a
					class="ui-control ui-control--primary"
					href="https://calendar.notion.so/meet/xupan/schedule"
					target="_blank"
					rel="noopener"
				>
					<Icon name="lucide:calendar-plus" class="func-icon" />
					Schedule a meeting
				</a>
				<a class="ui-control" href="mailto:xu.pan@ntu.edu.sg">
					<Icon name="lucide:mail" class="func-icon" />
					Send email
				</a>
			</div>
		</div>

		<div class="contact-location-map">
			<div class="contact-location">
				<h2>Office address</h2>
				<address>
					RSO 3, Room 3 (S2.2-B2-03)<br />
					School of Electrical and Electronic Engineering<br />
					Nanyang Technological University<br />
					50 Nanyang Avenue<br />
					Singapore 639798
				</address>
			</div>

			<div class="contact-map" aria-labelledby="contact-map-heading">
				<div class="contact-map__header">
					<h3 id="contact-map-heading">Find me at NTU</h3>
					<a class="ui-control" href={ntuMapPage} target="_blank" rel="noopener">
						Open NTU Maps <Icon name="lucide:arrow-up-right" class="func-icon" />
					</a>
				</div>
				<div class="contact-map__frame">
					<iframe
						title="NTU campus map showing S2.2-B2-03"
						src={ntuMapUrl}
						loading="lazy"
						referrerpolicy="strict-origin-when-cross-origin"></iframe>
				</div>
				<p class="contact-map__note">
					The map opens directly at <span>S2.2-B2-03</span>. Use the full NTU Maps view for indoor
					navigation.
				</p>
			</div>
		</div>

		<div class="contact-materials">
			<h2>Materials</h2>
			<div class="contact-materials__list">
				<a
					class="material-link"
					href="https://raw.githubusercontent.com/TwSphinx54/TwSphinx54.github.io/refs/heads/main/public/Resume.pdf"
					target="_blank"
					rel="noopener"
				>
					<span class="material-link__meta">EN</span><span>Curriculum vitae</span><Icon
						name="lucide:download"
						class="func-icon"
					/>
				</a>
				<a
					class="material-link"
					href="https://raw.githubusercontent.com/TwSphinx54/TwSphinx54.github.io/refs/heads/main/public/Resume_zh_CN.pdf"
					target="_blank"
					rel="noopener"
				>
					<span class="material-link__meta">ZH</span><span>个人简历</span><Icon
						name="lucide:download"
						class="func-icon"
					/>
				</a>
				<a
					class="material-link"
					href="https://linkedin.com/in/x-pan"
					target="_blank"
					rel="noopener"
				>
					<span class="material-link__meta">WEB</span><span>LinkedIn profile</span><Icon
						name="simple-icons:linkedin"
						class="func-icon"
					/>
				</a>
			</div>
		</div>
	</section>
</PageLayout>
