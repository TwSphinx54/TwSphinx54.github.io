---
import { Image } from "astro:assets";
import ProjectHero from "@/components/ProjectHero.astro";
import ProjectLayout from "@/layouts/Project.astro";
import introImage from "@/assets/projects/savla/intro.png";
import overviewImage from "@/assets/projects/savla/overview.png";
import fusionImage from "@/assets/projects/savla/fusion.png";
import evalNoiseImage from "@/assets/projects/savla/eval-noise.png";
import evalRewardImage from "@/assets/projects/savla/eval-reward.png";
import radarImage from "@/assets/projects/savla/radar.png";
import rewardImage from "@/assets/projects/savla/reward.png";
import trainingImage from "@/assets/projects/savla/training.png";

const authors = [
	{ name: "Xu Pan", href: "/", mark: "1,2" },
	{ name: "Zhenglin Wan", href: "https://vanzll.github.io/", mark: "3" },
	{ name: "Xingrui Yu", href: "https://xingruiyu.github.io/", mark: "2,*" },
	{
		name: "Xianwei Zheng",
		href: "https://jszy.whu.edu.cn/zhengxianwei/zh_CN/index.htm",
		mark: "1",
	},
	{ name: "Youkai Ke", href: "https://openreview.net/profile?id=~Youkai_Ke2", mark: "1" },
	{ name: "Ming Sun", href: "https://aaronsun2000.github.io/", mark: "4" },
	{ name: "Rui Wang", href: "https://people.ucas.ac.cn/~wr", mark: "4" },
	{ name: "Ziwei Wang", href: "https://ziweiwangthu.github.io/", mark: "5" },
	{
		name: "Ivor Tsang",
		href: "https://www.a-star.edu.sg/cfar/about-cfar/management/prof-ivor-tsang",
		mark: "2",
	},
];

const links = [
	{ label: "Paper", href: "https://arxiv.org/pdf/2602.00743.pdf", icon: "lucide:file-text" },
	{ label: "Code", href: "https://github.com/TwSphinx54/SA-VLA", icon: "simple-icons:github" },
	{
		label: "Model",
		href: "https://huggingface.co/SSSSphinx/SA-VLA",
		icon: "simple-icons:huggingface",
	},
	{ label: "arXiv", href: "https://arxiv.org/abs/2602.00743", icon: "lucide:external-link" },
];

const affiliations = [
	"State Key Laboratory of Information Engineering in Surveying, Mapping and Remote Sensing (LIESMARS), Wuhan University",
	"Centre for Frontier AI Research (CFAR), Institute of High Performance Computing (IHPC), Agency for Science, Technology and Research (A*STAR)",
	"Department of Computer Science, National University of Singapore",
	"Institute of Information Engineering, Chinese Academy of Sciences",
	"School of Electrical and Electronic Engineering, Nanyang Technological University",
];
const corners = ["tl", "tr", "bl", "br"];

const results = [
	{
		image: evalRewardImage,
		alt: "Training dynamics on the spatial-perturbation subset",
		caption:
			"Training dynamics on the LIBERO-PLUS spatial-perturbation subset. Dense rewards improve convergence stability and generalization under both few-shot (solid) and zero-shot (dashed) evaluation compared with sparse supervision.",
	},
	{
		image: trainingImage,
		alt: "Training dynamics under limited spatial coverage",
		caption:
			"Training dynamics under limited spatial coverage. Dense rewards stabilize optimization, while SCAN further improves performance with reduced variance. Shaded regions denote standard deviation over three seeds.",
	},
	{
		image: evalNoiseImage,
		alt: "Few-shot evaluation on LIBERO-PLUS",
		caption:
			"Few-shot evaluation on LIBERO-PLUS comparing SDE-based and learned exploration noise under sparse and dense rewards. Learned, policy-dependent noise achieves higher success rates with lower variance.",
	},
	{
		image: radarImage,
		alt: "Robustness improvement over pi 0.5",
		caption:
			"Robustness improvement over $\\pi_{0.5}$ in percentage points. CV and RIS are few-shot spatial shifts; the other conditions are zero-shot. SA-VLA provides consistent gains with minimal regressions.",
	},
	{
		image: rewardImage,
		alt: "Phase-wise dense reward visualization",
		caption:
			"Phase-wise dense reward visualization during execution. Reward rises with geometric progress toward the object or target region and falls when actions depart from the intended spatial trajectory.",
	},
];

const bibtex = `@inproceedings{pan2026savla,
  title={SA-VLA: Spatially-Aware Flow-Matching for Vision-Language-Action Reinforcement Learning},
  author={Xu Pan and Zhenglin Wan and Xingrui Yu and Xianwei Zheng and Youkai Ke and Ming Sun and Rui Wang and Ziwei Wang and Ivor Tsang},
  booktitle={IEEE/CVF Conference on Computer Vision and Pattern Recognition Workshops (CVPRW)},
  year={2026},
  url={https://arxiv.org/abs/2602.00743}
}`;
---

<ProjectLayout
	projectName="SA-VLA"
	navItems={[
		{ label: "Abstract", href: "#abstract-heading" },
		{ label: "Method", href: "#method-heading" },
		{ label: "Evaluation", href: "#evaluation-heading" },
		{ label: "Results", href: "#results-heading" },
		{ label: "In motion", href: "#video-heading" },
		{ label: "Citation", href: "#citation-heading" },
		{ label: "References", href: "#references-heading" },
	]}
	meta={{
		title: "SA-VLA",
		description: "Spatially-Aware Flow-Matching for Vision-Language-Action Reinforcement Learning.",
	}}
>
	<article class="project-page">
		<ProjectHero
			year="2026"
			title="SA-VLA: Spatially-Aware Flow-Matching for Vision-Language-Action Reinforcement Learning"
			{authors}
			{affiliations}
			notes={[{ mark: "*", text: "Corresponding author" }]}
			venue={{
				label:
					"IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR) 2026 Workshop on 3D-LLM/VLA",
				href: "https://3d-llm-vla.github.io/",
			}}
			{links}
		/>

		<section class="project-section" aria-labelledby="abstract-heading">
			<div class="section-label"><span>01</span><h2 id="abstract-heading">Abstract</h2></div>
			<div class="abstract-layout">
				<p class="project-abstract">
					RL fine-tuning can improve the in-distribution performance of flow-matching
					Vision-Language-Action policies while eroding their spatial generalization under viewpoint
					and layout shifts. We trace this failure to representation drift, sparse step-level
					supervision, and spatially unstructured exploration. SA-VLA restores spatial inductive
					bias by aligning implicit spatial representations, geometry-consistent dense rewards, and
					SCAN—spatially-conditioned annealed noise—in a shared latent space. Across cluttered
					manipulation benchmarks, it improves robustness under spatial shifts while maintaining
					in-distribution performance.
				</p>
				<figure class="abstract-figure">
					<div class="figure-media">
						{
							corners.map((corner) => (
								<span class={`figure-cross figure-cross--${corner}`} aria-hidden="true">
									+
								</span>
							))
						}
						<Image
							src={introImage}
							alt="Spatial inductive bias collapse and preservation in SA-VLA"
							loading="eager"
						/>
					</div>
					<figcaption>
						<strong>Fig. 1.</strong> Naive RL collapses spatial grounding; SA-VLA preserves it under identical
						perturbations.
					</figcaption>
				</figure>
			</div>
		</section>

		<section class="project-section" aria-labelledby="method-heading">
			<div class="section-label"><span>02</span><h2 id="method-heading">Method</h2></div>
			<div class="method-figures">
				<figure class="method-figure method-figure--overview">
					<div class="figure-media">
						{
							corners.map((corner) => (
								<span class={`figure-cross figure-cross--${corner}`} aria-hidden="true">
									+
								</span>
							))
						}
						<Image src={overviewImage} alt="Overview of the SA-VLA framework" loading="lazy" />
					</div>
					<figcaption>
						<strong>Fig. 2.</strong>
						<strong>Overview of SA-VLA.</strong> Visual and spatial tokens are fused into geometry-aware
						embeddings, then optimized through step-level dense rewards and spatially-conditioned exploration
						(SCAN) to preserve spatial inductive bias during RL adaptation.
					</figcaption>
				</figure>
				<figure class="method-figure">
					<div class="figure-media">
						{
							corners.map((corner) => (
								<span class={`figure-cross figure-cross--${corner}`} aria-hidden="true">
									+
								</span>
							))
						}
						<Image src={fusionImage} alt="Spatial token fusion module" loading="lazy" />
					</div>
					<figcaption>
						<strong>Fig. 3.</strong> Visual tokens attend to multi-view spatial tokens through unidirectional
						cross-attention. A learnable channel-wise gate controls the injection of geometry before the
						frozen VLM backbone.
					</figcaption>
				</figure>
			</div>
			<div class="method-grid">
				<article>
					<span>01</span><h3>Spatial token fusion</h3><p>
						Implicit multi-view spatial tokens are projected into the visual embedding space and
						fused before the frozen VLM. The asymmetric attention path and gated residual preserve
						pretrained semantics while adding layout and view cues.
					</p>
				</article>
				<article>
					<span>02</span><h3>SCAN exploration</h3><p>
						SCAN predicts action-noise scale from the geometry-aware latent and maintains an
						annealed lower bound. It explores uncertain, contact-sensitive states without letting
						stochasticity collapse during training.
					</p>
				</article>
				<article>
					<span>03</span><h3>Dense spatial reward</h3><p>
						A phase-conditioned reward decomposes manipulation into Approach, Relation–Actuation,
						and Stabilize. It provides geometric credit assignment from relative distances, contact
						state, and task progress.
					</p>
				</article>
			</div>
			<figure class="paper-table-figure" data-sync-table-caption>
				<div
					class="table-scroll"
					tabindex="0"
					role="region"
					aria-label="Unified goal modeling examples"
				>
					<table class="paper-table goal-table">
						<thead
							><tr
								><th scope="col">Instruction example</th><th scope="col">Family</th><th scope="col"
									>Goal specification</th
								></tr
							></thead
						>
						<tbody>
							<tr
								><td
									>Pick the akita black bowl between the plate and ramekin and place it on the
									plate.</td
								><td>place</td><td><code>place[On](akita_black_bowl_1 → plate_1)</code></td></tr
							>
							<tr
								><td>Open the middle layer of the drawer.</td><td>interact</td><td
									><code>interact[Open](wooden_cabinet_1_middle_region)</code></td
								></tr
							>
							<tr
								><td>Turn on the stove.</td><td>interact</td><td
									><code>interact[TurnOn](flat_stove_1)</code></td
								></tr
							>
							<tr
								><td>Turn on the stove and put the moka pot on it.</td><td>multi-goal</td><td
									><code
										>interact[TurnOn](flat_stove_1); place[On](moka_pot_1 →
										flat_stove_1_cook_region)</code
									></td
								></tr
							>
						</tbody>
					</table>
				</div>
				<figcaption class="table-caption">
					<strong>Table 1.</strong> Examples of unified goal modeling used by the dense reward module.
				</figcaption>
			</figure>
		</section>

		<section class="project-section" aria-labelledby="evaluation-heading">
			<div class="section-label"><span>03</span><h2 id="evaluation-heading">Evaluation</h2></div>
			<p class="project-abstract">
				We evaluate on LIBERO<sup class="citation-mark"><a href="#ref-3">[3]</a></sup> and LIBERO-PLUS<sup
					class="citation-mark"><a href="#ref-4">[4]</a></sup
				>, with camera-view (CV) and robot-initial-state (RIS) shifts that respectively alter
				observation geometry and action feasibility. Few-shot adaptation uses three demonstrations
				per task-shift pair, yielding 60 evaluation configurations. All models are initialized from
				a {"$\\pi_{0.5}$"} flow-matching policy and optimized with PPO; the VLM backbone remains frozen.
			</p>
			<div class="evaluation-grid">
				<div>
					<strong>+2.25 pp</strong><span
						>zero-shot total gain from spatial token fusion before RL</span
					>
				</div>
				<div>
					<strong>90.14%</strong><span>overall robustness for SA-VLA across perturbations</span>
				</div>
				<div>
					<strong>83.75%</strong><span>few-shot success in the full-model ablation setting</span>
				</div>
			</div>
			<div class="evidence-tables">
				<figure class="paper-table-figure" data-sync-table-caption>
					<div
						class="table-scroll"
						tabindex="0"
						role="region"
						aria-label="Spatial representation results"
					>
						<table class="paper-table">
							<thead
								><tr
									><th scope="col">Method</th><th scope="col">CV</th><th scope="col">RIS</th><th
										scope="col">Total</th
									></tr
								></thead
							>
							<tbody
								><tr
									><th scope="row">{"$\\pi_{0.5}$"} baseline</th><td>78.47</td><td>83.77</td><td
										>81.00</td
									></tr
								><tr class="paper-table__ours"
									><th scope="row">SA-VLA w/ spatial fusion</th><td><strong>82.30</strong></td><td
										><strong>84.29</strong></td
									><td><strong>83.25</strong></td></tr
								></tbody
							>
						</table>
					</div>
					<figcaption class="table-caption">
						<strong>Table 2.</strong> Zero-shot success rate (%) on the LIBERO-PLUS<sup
							class="citation-mark"><a href="#ref-4">[4]</a></sup
						> spatial-perturbation subset, before RL adaptation.
					</figcaption>
				</figure>
				<figure class="paper-table-figure" data-sync-table-caption>
					<div
						class="table-scroll"
						tabindex="0"
						role="region"
						aria-label="Leave-one-out ablation results"
					>
						<table class="paper-table">
							<thead
								><tr
									><th scope="col">Method</th><th scope="col">SCAN</th><th scope="col">DR</th><th
										scope="col">Fusion</th
									><th scope="col">SR (%)</th></tr
								></thead
							>
							<tbody
								><tr
									><th scope="row">{"$\\pi_{0.5}$"} baseline</th><td>–</td><td>–</td><td>–</td><td
										>81.00</td
									></tr
								><tr><th scope="row">w/o Fusion</th><td>–</td><td>✓</td><td>–</td><td>81.75</td></tr
								><tr><th scope="row">w/o DR</th><td>–</td><td>–</td><td>✓</td><td>77.50</td></tr><tr
									><th scope="row">w/o SCAN</th><td>–</td><td>✓</td><td>✓</td><td>83.00</td></tr
								><tr class="paper-table__ours"
									><th scope="row">SA-VLA</th><td>✓</td><td>✓</td><td>✓</td><td
										><strong>83.75</strong></td
									></tr
								></tbody
							>
						</table>
					</div>
					<figcaption class="table-caption">
						<strong>Table 3.</strong> Leave-one-out ablation on the LIBERO-PLUS<sup
							class="citation-mark"><a href="#ref-4">[4]</a></sup
						> few-shot spatial-perturbation setting.
					</figcaption>
				</figure>
			</div>
		</section>

		<section class="project-section" aria-labelledby="results-heading">
			<div class="section-label"><span>04</span><h2 id="results-heading">Results</h2></div>
			<div class="results-intro">
				<p>
					We separate three questions: whether dense feedback stabilizes optimization, whether
					structured noise improves coverage under sparse data, and whether the resulting policy
					transfers across heterogeneous perturbations. The sequence below follows that progression.
				</p>
			</div>
			<div class="results-grid">
				{
					results.slice(0, 4).map((result, index) => (
						<figure class={`result-card result-card--${index}`}>
							<>
								<div class="figure-media">
									{corners.map((corner) => (
										<span class={`figure-cross figure-cross--${corner}`} aria-hidden="true">
											+
										</span>
									))}
									<Image src={result.image} alt={result.alt} loading="lazy" />
								</div>
								<figcaption>
									<strong>Fig. {index + 4}.</strong> {result.caption}
									{index === 3 && (
										<sup class="citation-mark">
											<a href="#ref-1">[1]</a>
										</sup>
									)}
								</figcaption>
							</>
						</figure>
					))
				}
				<figure class="result-table-figure" data-sync-table-caption>
					<div
						class="table-scroll"
						tabindex="0"
						role="region"
						aria-label="Robustness results table"
					>
						<table class="result-table">
							<thead
								><tr
									><th scope="col">Methods</th><th scope="col">Total</th><th scope="col">BT</th><th
										scope="col">CV<sup>†</sup></th
									><th scope="col">LI</th><th scope="col">LC</th><th scope="col">OL</th><th
										scope="col">RIS<sup>†</sup></th
									><th scope="col">SN</th></tr
								></thead
							>
							<tbody>
								<tr
									><th scope="row">{"$\\pi_{0.5}$"}</th><td><u>88.96</u></td><td><u>100.0</u></td
									><td>82.16</td><td><strong>88.63</strong></td><td><u>98.54</u></td><td
										><u>100.0</u></td
									><td><strong>83.74</strong></td><td>87.93</td></tr
								>
								<tr
									><th scope="row">ReinFlow</th><td>87.92 <span>± 0.81</span></td><td
										>97.53 <span>± 0.53</span></td
									><td><u>84.32</u> <span>± 0.94</span></td><td
										>84.20 <span>± <strong>1.45</strong></span></td
									><td>97.32 <span>± 1.69</span></td><td>100.0 <span>± 0.00</span></td><td
										>79.15 <span>± 1.58</span></td
									><td><u>92.72</u> <span>± 2.32</span></td></tr
								>
								<tr class="result-table__ours"
									><th scope="row">SA-VLA</th><td
										><strong>90.14</strong> <span>± <strong>0.35</strong></span></td
									><td><strong>100.0</strong> <span>± <strong>0.00</strong></span></td><td
										><strong>87.21</strong> <span>± <strong>0.31</strong></span></td
									><td><u>86.10</u> <span>± 1.52</span></td><td
										><strong>98.54</strong> <span>± <strong>1.26</strong></span></td
									><td><strong>100.0</strong> <span>± <strong>0.00</strong></span></td><td
										><u>83.09</u> <span>± <strong>0.57</strong></span></td
									><td><strong>93.30</strong> <span>± <strong>1.85</strong></span></td></tr
								>
							</tbody>
						</table>
					</div>
					<figcaption class="table-caption">
						<strong>Table 4.</strong> Robustness under diverse perturbations. We evaluate {
							"$\\pi_{0.5}$"
						}<sup class="citation-mark"><a href="#ref-1">[1]</a></sup>, ReinFlow<sup
							class="citation-mark"><a href="#ref-2">[2]</a></sup
						>, and SA-VLA. Results report success rate in % (mean {"$\\pm$"} std). CV and RIS are few-shot
						spatial shifts; others are zero-shot. Total is averaged across all conditions. <span
							class="table-note"><sup>†</sup> Few-shot spatial shift.</span
						>
					</figcaption>
				</figure>
				{
					results.slice(4).map((result) => (
						<figure class="result-card result-card--reward">
							<div class="figure-media">
								{corners.map((corner) => (
									<span class={`figure-cross figure-cross--${corner}`} aria-hidden="true">
										+
									</span>
								))}
								<Image src={result.image} alt={result.alt} loading="lazy" />
							</div>
							<figcaption>
								<strong>Fig. 8.</strong> {result.caption}
							</figcaption>
						</figure>
					))
				}
			</div>
		</section>

		<section class="project-section" aria-labelledby="video-heading">
			<div class="section-label"><span>05</span><h2 id="video-heading">In motion</h2></div>
			<figure class="video-figure">
				<video controls muted loop playsinline preload="metadata"
					><source src="/projects/savla/video.mp4" type="video/mp4" /></video
				><figcaption>
					Representative rollouts under spatial perturbations. Eight keyframes are uniformly sampled
					from each successful episode; despite camera-view and robot-initial-state variation, the
					policy maintains coherent task progression and completes the intended manipulation.
				</figcaption>
			</figure>
		</section>

		<section class="project-section" aria-labelledby="citation-heading">
			<div class="section-label"><span>06</span><h2 id="citation-heading">Citation</h2></div>
			<div class="citation">
				<pre><code>{bibtex}</code></pre><button class="copy-button" type="button" data-copy-bibtex
					>Copy BibTeX</button
				>
			</div>
		</section>

		<section class="project-section references-section" aria-labelledby="references-heading">
			<div class="section-label"><span>07</span><h2 id="references-heading">References</h2></div>
			<ol class="references-list">
				<li id="ref-1">
					<span
						>Physical Intelligence, K. Black, N. Brown, et al. “{"$\\pi_{0.5}$"}: A
						Vision-Language-Action Model with Open-World Generalization.” arXiv:2504.16054, 2025.</span
					>
					<a href="https://arxiv.org/abs/2504.16054" target="_blank" rel="noreferrer">arXiv</a>
				</li>
				<li id="ref-2">
					<span
						>T. Zhang, C. Yu, S. Su, and Y. Wang. “ReinFlow: Fine-tuning Flow Matching Policy with
						Online Reinforcement Learning.” NeurIPS, 2025.</span
					>
					<a href="https://arxiv.org/abs/2505.22094" target="_blank" rel="noreferrer">arXiv</a>
				</li>
				<li id="ref-3">
					<span
						>B. Liu, Y. Zhu, C. Gao, et al. “LIBERO: Benchmarking Knowledge Transfer for Lifelong
						Robot Learning.” NeurIPS, 2023.</span
					>
					<a href="https://arxiv.org/abs/2306.03310" target="_blank" rel="noreferrer">arXiv</a>
				</li>
				<li id="ref-4">
					<span
						>S. Fei, S. Wang, J. Shi, et al. “LIBERO-Plus: In-depth Robustness Analysis of
						Vision-Language-Action Models.” arXiv:2510.13626, 2025.</span
					>
					<a href="https://arxiv.org/abs/2510.13626" target="_blank" rel="noreferrer">arXiv</a>
				</li>
			</ol>
		</section>
	</article>
</ProjectLayout>

<style>
	.project-page {
		width: min(100%, 760px);
		margin: 0;
	}
	.section-label span {
		margin: 0 0 22px;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.project-section {
		--section-pad: clamp(58px, 6.5vw, 78px);
		width: 100% !important;
		padding: var(--section-pad) 0 !important;
	}
	.project-section::before {
		display: none;
	}
	.section-label {
		position: relative;
		margin-bottom: 26px;
	}
	.section-label span {
		position: absolute;
		top: 0.48em;
		left: -76px;
		margin: 0;
		line-height: 1;
	}
	.section-label h2 {
		margin: 0 !important;
		font-family: var(--font-sans);
		font-size: 18px !important;
