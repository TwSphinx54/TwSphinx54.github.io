		</section>
	</article>
</ProjectLayout>

<style>
	.project-page {
		width: min(100%, 760px);
	}
	.section-label span {
		margin: 0 0 22px;
		color: var(--muted);
		font: 9px var(--font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.project-section {
		width: 100% !important;
		padding: clamp(58px, 6.5vw, 78px) 0 !important;
	}
	.project-section:before {
		display: none;
	}
	.section-label {
		position: relative;
		margin-bottom: 26px;
