---
import BaseHead from "@/components/BaseHead.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/site-config";

const meta = {
	description: "Oops! It looks like this page is lost in space!",
	title: "Oops! You found a missing page!",
};
---

<html class="scroll-smooth" lang={siteConfig.lang}>
	<head>
		<BaseHead description={meta.description} title={meta.title} />
	</head>
	<body class="error-page">
		<ThemeProvider />
		<div class="error-page__content">
			<span class="error-page__index">ERROR / 404</span>
			<h1>Lost in<br />the latent space.</h1>
			<p>The requested coordinate does not exist.</p>
			<a href="/" class="ui-control error-page__link">
				<Icon name="lucide:arrow-left" class="func-icon h-4 w-4" aria-hidden="true" />
				Back to Home
			</a>
		</div>
	</body><style>
		.error-page {
			display: grid;
			min-height: 100vh;
			place-items: center;
			padding: 24px;
		}
		.error-page__content {
			width: min(92vw, 820px);
			padding: 48px 0;
			border-top: 1px solid var(--line);
			border-bottom: 1px solid var(--line);
		}
		.error-page__index {
			color: var(--muted);
			font-family: var(--font-mono);
			font-size: 10px;
			letter-spacing: 0.08em;
		}
		.error-page h1 {
			margin: 64px 0 28px;
			font-family: var(--font-sans);
			font-size: clamp(2.5rem, 7vw, 4.5rem);
			font-weight: 400;
			letter-spacing: -0.035em;
			line-height: 0.92;
		}
		.error-page p {
			color: var(--muted);
		}
		.error-page__link {
			gap: 8px;
			margin-top: 24px;
			padding: 9px 12px;
		}
	</style>
</html>
