---
import { Icon } from "astro-icon/components";
---

<!-- Abstract / Image Modal Common Elements and Scripts -->
<div
	id="img-modal"
	class="pointer-events-none fixed inset-0 z-[110] flex hidden items-center justify-center bg-black/40 p-4 opacity-0 shadow-2xl backdrop-blur-sm transition-all duration-300"
>
	<div
		class="pointer-events-auto relative mt-16 flex max-h-[90vh] max-w-[90vw] scale-95 items-center justify-center transition-transform duration-300"
		id="img-modal-content"
	>
		<button
			id="img-modal-close"
			class="ui-press absolute right-3 top-3 z-20 inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-zinc-200/70 bg-white/90 text-accent shadow-md hover:bg-accent/10 dark:border-zinc-700/70 dark:bg-zinc-900/90 dark:hover:bg-accent/20"
			aria-label="Close image modal"
		>
			<Icon name="lucide:x" class="func-icon" width="16" height="16" aria-hidden="true" />
		</button>
		<img
			id="img-modal-img"
			src=""
			alt="Large image"
			class="max-h-[90vh] max-w-full rounded-2xl object-contain shadow-2xl ring-1 ring-white/20"
		/>
	</div>
</div>

<script>
	function initAbstractToggles() {
		const buttons = document.querySelectorAll(".abstract-btn");
		buttons.forEach((btn) => {
			btn.addEventListener("click", (e) => {
				e.preventDefault();
				const id = btn.getAttribute("data-abstract-id");
				if (!id) return;

				const contentId = id.replace("abstract-", "abstract-content-");
				const content = document.getElementById(contentId);
				const chev = btn.querySelector(".chev");
				if (!content) return;

				const isCollapsed = content.getAttribute("data-collapsed") === "true";

				if (isCollapsed) {
					content.style.maxHeight = content.scrollHeight + "px";
					content.style.opacity = "1";
					content.setAttribute("data-collapsed", "false");
					btn.setAttribute("aria-expanded", "true");
					chev?.classList.add("rotate-180");

					// Allow auto height after transition
					setTimeout(() => {
						if (content.getAttribute("data-collapsed") === "false") {
							content.style.maxHeight = "none";
						}
					}, 310);
				} else {
					// Set height back to scrollHeight for transition to 0
					content.style.maxHeight = content.scrollHeight + "px";
					content.offsetHeight; // force reflow
					content.style.maxHeight = "0";
					content.style.opacity = "0";
					content.setAttribute("data-collapsed", "true");
					btn.setAttribute("aria-expanded", "false");
					chev?.classList.remove("rotate-180");
				}
			});
		});
	}

	function initImageModal() {
		const modal = document.getElementById("img-modal");
		const modalContent = document.getElementById("img-modal-content");
		const modalImg = document.getElementById("img-modal-img") as HTMLImageElement;
		const modalClose = document.getElementById("img-modal-close");

		if (!modal || !modalImg) return;

		function open(src: string) {
			modalImg.src = src;
			modal?.classList.remove("hidden", "pointer-events-none", "opacity-0");
			modal?.classList.add("opacity-100");
			modalContent?.classList.remove("scale-95");
			modalContent?.classList.add("scale-100");
			document.body.style.overflow = "hidden";
			(modalClose as HTMLElement)?.focus?.();
		}

		function close() {
			modal?.classList.add("pointer-events-none", "opacity-0");
			modal?.classList.remove("opacity-100");
			modalContent?.classList.remove("scale-100");
			modalContent?.classList.add("scale-95");
			document.body.style.overflow = "";
			setTimeout(() => {
				if (modal?.classList.contains("opacity-0")) {
					modal?.classList.add("hidden");
					modalImg.src = "";
				}
			}, 310);
		}

		modalClose?.addEventListener("click", close);
		modal.addEventListener("click", (e) => {
			if (e.target === modal) close();
		});
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") close();
		});

		document.addEventListener("click", (e) => {
			const t = e.target;
			if (!(t instanceof HTMLImageElement)) return;
			if (!t.classList.contains("pub-thumb-img")) return;
			const src = t.dataset.fullsrc || t.currentSrc || t.src;
			if (src) open(src);
		});
	}

	const SEMANTIC_SCHOLAR_CACHE_PREFIX = "semanticScholarCitationCount:";
	const SEMANTIC_SCHOLAR_CACHE_TTL_MS = 60 * 60 * 1000;

	function normalizeSemanticScholarId(raw: string | null | undefined): string {
		return typeof raw === "string" ? raw.trim().toLowerCase() : "";
	}

	function getSemanticScholarCacheKey(id: string): string {
		return `${SEMANTIC_SCHOLAR_CACHE_PREFIX}${id}`;
	}

	function readSemanticScholarCache(id: string): number | null {
		try {
			const raw = localStorage.getItem(getSemanticScholarCacheKey(id));
			if (!raw) return null;
			const parsed = JSON.parse(raw);
			if (
				!parsed ||
				typeof parsed.timestamp !== "number" ||
				Date.now() - parsed.timestamp > SEMANTIC_SCHOLAR_CACHE_TTL_MS
			) {
				localStorage.removeItem(getSemanticScholarCacheKey(id));
				return null;
			}
			return typeof parsed.citationCount === "number" ? parsed.citationCount : null;
		} catch {
			return null;
		}
	}

	function writeSemanticScholarCache(id: string, citationCount: number) {
		try {
			localStorage.setItem(
				getSemanticScholarCacheKey(id),
				JSON.stringify({
					paperId: id,
					citationCount,
					timestamp: Date.now(),
				}),
			);
		} catch {
			// Ignore storage failures.
		}
	}

	function renderSemanticScholarBadge(
		target: Element,
		id: string,
		citationCount: number,
	) {
		if (!(target instanceof HTMLElement) || typeof citationCount !== "number") return;

		target.replaceChildren();
		const link = document.createElement("a");
		link.href = `https://www.semanticscholar.org/paper/${id}`;
		link.target = "_blank";
		link.rel = "noopener noreferrer";
		link.title = "Semantic Scholar citation count";
		link.className =
			"semantic-scholar-citation inline-flex items-center rounded-full bg-sky-100 px-2 py-0.5 text-sm font-medium text-sky-700 dark:bg-sky-900/30 dark:text-sky-300";

		const text = document.createElement("span");
		text.textContent = `${citationCount} citation${citationCount === 1 ? "" : "s"}`;

		link.append(text);
		target.append(link);
	}

	async function initSemanticScholarCitations() {
		const targets = Array.from(document.querySelectorAll("[data-semantic-scholar-id]"));
		if (targets.length === 0) return;

		const targetGroups = new Map<string, Element[]>();
		for (const target of targets) {
			const id = normalizeSemanticScholarId(target.getAttribute("data-semantic-scholar-id"));
			if (!id) continue;
			if (!targetGroups.has(id)) targetGroups.set(id, []);
			const group = targetGroups.get(id);
			if (group) group.push(target);
		}

		if (targetGroups.size === 0) return;

		const uncachedIds = [];
		for (const [id, group] of targetGroups.entries()) {
			const cachedCitationCount = readSemanticScholarCache(id);
			if (typeof cachedCitationCount === "number") {
				group.forEach((target: Element) =>
					renderSemanticScholarBadge(target, id, cachedCitationCount),
				);
			} else {
				uncachedIds.push(id);
			}
		}

		if (uncachedIds.length === 0) return;

		try {
			const response = await fetch(
				"https://api.semanticscholar.org/graph/v1/paper/batch?fields=citationCount",
				{
					method: "POST",
					headers: {
						"Content-Type": "application/json",
					},
					body: JSON.stringify({ ids: uncachedIds }),
				},
			);
			if (!response.ok) return;

			const papers = await response.json();
			if (!Array.isArray(papers)) return;

			for (const paper of papers) {
				const id = normalizeSemanticScholarId(paper?.paperId);
				const citationCount =
					typeof paper?.citationCount === "number" ? paper.citationCount : null;
				if (!id || citationCount === null) continue;

				writeSemanticScholarCache(id, citationCount);
				const group = targetGroups.get(id);
				if (group) {
					group.forEach((target: Element) =>
						renderSemanticScholarBadge(target, id, citationCount),
					);
				}
			}
		} catch {
			// Ignore fetch failures and leave placeholders empty.
		}
	}

	function setup() {
		initAbstractToggles();
		initImageModal();
		initSemanticScholarCitations();
	}

	setup();
	document.addEventListener("astro:after-swap", setup);
</script>
