---
import { menuLinks } from "@/site-config";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__brand">
		<p>Spatial intelligence<br />for the physical world.</p>
	</div>

	<div class="site-footer__group">
		<span class="site-footer__label">Explore</span>
		<nav aria-label="More on this site">
			{menuLinks.map((link) => <a href={link.path}>{link.title}</a>)}
		</nav>
	</div>

	<div class="site-footer__group">
		<span class="site-footer__label">Connect</span>
		<nav aria-label="External profiles">
			<a href="mailto:panxurs@whu.edu.cn">Email</a>
			<a href="https://calendar.notion.so/meet/xupan/schedule" target="_blank" rel="noreferrer"
				>Schedule meeting</a
			>
			<a href="https://github.com/TwSphinx54" target="_blank" rel="noreferrer">GitHub</a>
			<a href="https://linkedin.com/in/x-pan" target="_blank" rel="noreferrer">LinkedIn</a>
		</nav>
	</div>

	<div class="site-footer__group site-footer__colophon">
		<span class="site-footer__label">Colophon</span>
		<p>Vision · Geometry · Intelligence</p>
		<p>Singapore / UTC+8</p>
		<p>&copy; {year} Xu Pan</p>
	</div>
</footer>
