---
import { menuLinks } from "@/site-config";
import ThemeToggle from "../ThemeToggle.astro";

const url = new URL(Astro.request.url);
const socialLinks = [
	{ label: "Email", href: "mailto:panxurs@whu.edu.cn" },
	{ label: "X", href: "https://x.com/xupan_x" },
	{ label: "Google Scholar", href: "https://scholar.google.com/citations?user=IuCPqLcAAAAJ" },
	{ label: "Bluesky", href: "https://bsky.app/profile/xu-pan.bsky.social" },
	{ label: "LinkedIn", href: "https://linkedin.com/in/x-pan" },
	{ label: "ResearchGate", href: "https://www.researchgate.net/profile/Xu-Pan-10" },
	{ label: "Semantic Scholar", href: "https://www.semanticscholar.org/author/Xu-Pan/2387896133" },
	{ label: "ORCID", href: "https://orcid.org/0009-0007-3297-0385" },
	{ label: "GitHub", href: "https://github.com/TwSphinx54" },
	{ label: "Hugging Face", href: "https://huggingface.co/SSSSphinx" },
];
---

<header class="site-header" id="main-header">
	<div class="site-brand">
		<a href="/" class="site-mark" aria-label="Xu Pan — Home">
			<span class="site-mark__name">Xu Pan <em>潘旭</em></span>
		</a>
		<p class="site-role">Incoming Research Associate at Nanyang Technological University</p>
	</div>

	<nav aria-label="Main menu" class="site-nav" id="navigation-menu">
		{
			menuLinks.map((link) => (
				<a
					aria-current={url.pathname === link.path ? "page" : false}
					data-astro-prefetch
					href={link.path}
				>
					{link.title}
				</a>
			))
		}
	</nav>

	<div class="site-header__meta site-header__meta--mobile">
		<nav class="site-socials" aria-label="Social profiles">
			{
				socialLinks.map((link) => (
					<a href={link.href} target="_blank" rel="noreferrer">
						{link.label}
					</a>
				))
			}
		</nav>
		<ThemeToggle />
	</div>
</header>

<div class="site-header__meta-boundary">
	<div class="site-header__meta-viewport">
		<div class="site-header__meta site-header__meta--desktop">
			<nav class="site-socials" aria-label="Social profiles">
				{
					socialLinks.map((link) => (
						<a href={link.href} target="_blank" rel="noreferrer">
							{link.label}
						</a>
					))
				}
			</nav>
			<ThemeToggle />
		</div>
	</div>
</div>
