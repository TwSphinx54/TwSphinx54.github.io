---
// Source: DualSys/scripts/plot_plus.py; counts are from data/plus_summary.json
// and data/expert12k_plus.json. Overall is the pooled 2,519-episode rate.
// Lieflat F8 Plumb Scatter: dots, fine plumb lines, and a barcode floor.
const rows = [
	{ label: "Viewpoint", n: 419, counts: [230, 228, 234, 227, 214, 209] },
	{ label: "Object layout", n: 312, counts: [270, 261, 270, 278, 253, 247] },
	{ label: "Language", n: 383, counts: [348, 343, 345, 341, 333, 337] },
	{ label: "Overall", n: 2519, counts: [1997, 2005, 1974, 2019, 1924, 1967] },
	{ label: "Background", n: 289, counts: [257, 256, 254, 262, 265, 271] },
	{ label: "Lighting", n: 274, counts: [248, 256, 256, 257, 231, 242] },
	{ label: "Robot state", n: 393, counts: [296, 309, 287, 297, 289, 307] },
	{ label: "Sensor noise", n: 449, counts: [348, 352, 328, 357, 339, 354] },
];
const piLabel = String.raw`$\pi_{0.5}$`;
const series = ["pi 0.5 · 10-step", "pi 0.5 · 1-step", "CauSyncVLA · 1-step"];
const fmt = (n: number) => `${n >= 0 ? "+" : "−"}${Math.abs(n).toFixed(2)}`;
const floor = -3.4;
const delta = (counts: number[], n: number, i: number) =>
	(100 * (counts[i * 2 + 1] - counts[i * 2])) / n;
// Orthographic projection of the paper's controller × perturbation × success-delta view.
const project = (arm: number, row: number, value: number) => ({
	x: 268 + arm * 87 - row * 25,
	y: 350 - arm * 28 - row * 14 - (value - floor) * 19,
});
const coord = (arm: number, row: number, value: number) => {
	const p = project(arm, row, value);
	return `${p.x},${p.y}`;
};
---

<div class="plus-chart" data-plus-chart>
	<p class="plus-chart__legend" aria-hidden="true">
		<span><b class="plus-chart__key plus-chart__key--square"></b>{piLabel} · 10-step</span>
		<span><b class="plus-chart__key plus-chart__key--circle"></b>{piLabel} · 1-step</span>
		<span><b class="plus-chart__key plus-chart__key--diamond"></b>CauSyncVLA · 1-step</span>
	</p>
	<p class="plus-chart__readout" aria-live="polite" aria-atomic="true" data-plus-readout>
		Hover, focus, or tap a point to inspect its paired success rates.
	</p>
	<p class="plus-chart__scroll-hint">Scroll sideways to explore the full chart.</p>
	<div
		class="plus-chart__scroll"
		role="region"
		aria-label="PFWS effect chart, horizontally scrollable"
	>
		<svg
			class="plus-chart__svg"
			viewBox="0 0 560 400"
			role="group"
			aria-label="Three-dimensional view of changes in success rate with PFWS relative to cold starts, in percentage points"
		>
			<text
				x="14"
				y="180"
				transform="rotate(-90 14 180)"
				text-anchor="middle"
				class="plus-chart__axis">SUCCESS Δ (PP)</text
			>
			{
				[-2, 0, 2, 4, 6].map((tick) => {
					const a = project(0, 7, tick);
					const b = project(2, 7, tick);
					const c = project(2, 0, tick);
					return (
						<g aria-hidden="true">
							<polyline
								points={`${a.x},${a.y} ${b.x},${b.y} ${c.x},${c.y}`}
								class:list={["plus-chart__grid", { "plus-chart__zero": tick === 0 }]}
							/>
							<text x={a.x - 8} y={a.y + 3} text-anchor="end" class="plus-chart__axis">
								{tick > 0 ? `+${tick}` : tick}
							</text>
						</g>
					);
				})
			}
			<polyline
				points={`${coord(0, 7, 7.4)} ${coord(0, 7, floor)} ${coord(0, 0, floor)} ${coord(2, 0, floor)}`}
				class="plus-chart__frame"
				aria-hidden="true"></polyline>
			{
				["10-step", "1-step", "CauSyncVLA"].map((label, j) => {
					const p = project(j, 0, floor);
					return (
						<text x={p.x} y={p.y + 16} text-anchor="middle" class="plus-chart__axis">
							{label}
						</text>
					);
				})
			}
			{
				rows.map((row, i) => {
					const p = project(0, i, floor);
					return (
						<text
							x={p.x - 9}
							y={p.y + 4}
							text-anchor="end"
							class:list={[
								"plus-chart__label",
								{ "plus-chart__label--overall": row.label === "Overall" },
							]}
						>
							{row.label}
						</text>
					);
				})
			}
			{
				[...rows].map((_, offset) => {
					const i = rows.length - 1 - offset;
					const row = rows[i];
					const points = [
						coord(0, i, floor),
						...series.map((_, j) => coord(j, i, delta(row.counts, row.n, j))),
						coord(2, i, floor),
					].join(" ");
					return (
						<g aria-hidden="true">
							<polygon
								points={points}
								class="plus-chart__curtain"
								style={`--slice-strength: ${22 + i * 5}%`}
							/>
							<polyline
								points={`${coord(0, i, 0)} ${coord(2, i, 0)}`}
								class="plus-chart__zero-line"
							/>
						</g>
					);
				})
			}
			{
				series.map((_, j) => (
					<polyline
						points={rows.map((row, i) => coord(j, i, delta(row.counts, row.n, j))).join(" ")}
						class:list={["plus-chart__series", `plus-chart__series--${j}`]}
						aria-hidden="true"
					/>
				))
			}
			{
				rows.map((row, i) =>
					series.map((name, j) => {
						const value = delta(row.counts, row.n, j);
						const point = project(j, i, value);
						const label = `${row.label}, ${name}: ${fmt(value)} percentage points; PFWS ${row.counts[j * 2 + 1]} of ${row.n}, cold ${row.counts[j * 2]} of ${row.n}.`;
						return (
							<g
								class:list={["plus-chart__point", `plus-chart__point--${j}`]}
								tabindex="0"
								role="button"
								aria-label={label}
								aria-pressed="false"
								data-message={label}
							>
								{j === 0 && (
									<rect
										x={point.x - 4}
										y={point.y - 4}
										width="8"
										height="8"
										class="plus-chart__mark"
									/>
								)}
								{j === 1 && <circle cx={point.x} cy={point.y} r="4.2" class="plus-chart__mark" />}
								{j === 2 && (
									<path
										d={`M ${point.x} ${point.y - 5} l 5 5 l -5 5 l -5 -5 Z`}
										class="plus-chart__mark"
									/>
								)}
								<circle cx={point.x} cy={point.y} r="9" class="plus-chart__hit" />
							</g>
						);
					}),
				)
			}
		</svg>
	</div>
	<details class="plus-chart__table-wrap">
		<summary>View all values</summary>
		<div class="plus-chart__table-scroll">
			<table>
				<caption>PFWS success-rate change relative to cold starts, percentage points</caption>
				<thead
					><tr
						><th scope="col">Perturbation</th>{
							series.map((name, i) => (
								<th scope="col">
									{i < 2 ? (
										<>
											{piLabel} · {i === 0 ? "10-step" : "1-step"}
										</>
									) : (
										name
									)}
								</th>
							))
						}<th scope="col">Episodes per arm</th></tr
					></thead
				>
				<tbody
					>{
						rows.map((row) => (
							<tr>
								<th scope="row">{row.label}</th>
								{series.map((_, j) => (
									<td>{fmt(delta(row.counts, row.n, j))}</td>
								))}
								<td>{row.n.toLocaleString("en-US")}</td>
							</tr>
						))
					}</tbody
				>
			</table>
		</div>
	</details>
</div>

<script>
	for (const chart of document.querySelectorAll<HTMLElement>("[data-plus-chart]")) {
		const readout = chart.querySelector<HTMLElement>("[data-plus-readout]");
		const points = Array.from(chart.querySelectorAll<SVGGElement>(".plus-chart__point"));
		const initial = readout?.textContent?.trim() ?? "";
		let pinned: SVGGElement | null = null;
		const show = (point: SVGGElement | null) => {
			if (readout) readout.textContent = point?.dataset.message ?? initial;
			for (const item of points) {
				item.classList.toggle("is-active", item === point);
				item.setAttribute("aria-pressed", String(item === pinned));
			}
		};
		for (const [index, point] of points.entries()) {
			point.addEventListener("pointerenter", () => show(point));
			point.addEventListener("pointerleave", () => show(pinned));
			point.addEventListener("focus", () => show(point));
			point.addEventListener("blur", () => show(pinned));
			const toggle = () => {
				pinned = pinned === point ? null : point;
				show(pinned ?? point);
			};
			point.addEventListener("click", toggle);
			point.addEventListener("keydown", (event: KeyboardEvent) => {
				if (event.key === "Enter" || event.key === " ") {
					event.preventDefault();
					toggle();
				} else if (event.key === "Escape") {
					pinned = null;
					show(point);
				} else if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
					event.preventDefault();
					points[
						Math.max(0, Math.min(points.length - 1, index + (event.key === "ArrowRight" ? 1 : -1)))
					]?.focus();
				}
			});
		}
	}
</script>

<style>
	.plus-chart {
		color: var(--ink);
		padding: 16px 12px 12px;
	}
	.plus-chart__legend {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 18px;
		margin: 0;
		font: 10px var(--font-mono);
		color: var(--muted);
	}
	.plus-chart__legend span {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.plus-chart__key {
		display: inline-block;
		width: 8px;
		height: 8px;
		border: 1.5px solid var(--ink);
	}
	.plus-chart__key--circle {
		border-radius: 50%;
		background: var(--muted);
	}
	.plus-chart__key--diamond {
		transform: rotate(45deg);
		background: var(--ink);
	}
	.plus-chart__readout {
		min-height: 2.6em;
		margin: 12px 0 0;
		font: 10px/1.45 var(--font-mono);
		color: var(--muted);
	}
	.plus-chart__scroll,
	.plus-chart__table-scroll {
		overflow-x: auto;
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	.plus-chart__scroll::-webkit-scrollbar,
	.plus-chart__table-scroll::-webkit-scrollbar {
		display: none;
	}
	.plus-chart__svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.plus-chart__scroll-hint {
		display: none;
		margin: 0 0 4px;
		color: var(--muted);
		font: 10px var(--font-mono);
	}
	.plus-chart__grid {
		fill: none;
		stroke: var(--line);
		stroke-width: 0.7;
	}
	.plus-chart__frame {
		fill: none;
		stroke: var(--line-strong);
		stroke-width: 1;
	}
	.plus-chart__curtain {
		fill: color-mix(in srgb, var(--signal) var(--slice-strength), var(--paper));
		fill-opacity: 0.42;
		stroke: color-mix(in srgb, var(--signal) 45%, var(--muted));
		stroke-width: 0.8;
	}
	.plus-chart__zero-line {
		fill: none;
		stroke: var(--muted);
		stroke-width: 0.8;
		stroke-dasharray: 2 3;
	}
	.plus-chart__series {
		fill: none;
		stroke: var(--muted);
		stroke-width: 1.2;
		stroke-dasharray: 5 3;
	}
	.plus-chart__series--2 {
		stroke: var(--signal);
		stroke-width: 1.8;
	}
	.plus-chart__zero {
		stroke: var(--line-strong);
		stroke-width: 1;
	}
	.plus-chart__tick {
		stroke: var(--line-strong);
		stroke-width: 0.7;
	}
	.plus-chart__axis,
	.plus-chart__label {
		fill: var(--muted);
		font: 10px var(--font-mono);
	}
	.plus-chart__label--overall {
		fill: var(--ink);
		font-weight: 700;
	}
	.plus-chart__point {
		cursor: pointer;
		outline: none;
	}
	.plus-chart__plumb {
		stroke: var(--muted);
		stroke-width: 0.65;
		opacity: 0.65;
	}
	.plus-chart__mark {
		stroke: var(--ink);
		stroke-width: 1.2;
		fill: var(--paper);
	}
	.plus-chart__point--1 .plus-chart__mark {
		fill: var(--muted);
	}
	.plus-chart__point--2 .plus-chart__mark {
		fill: var(--ink);
	}
	.plus-chart__hit {
		fill: transparent;
		pointer-events: all;
	}
	.plus-chart__point.is-active .plus-chart__mark,
	.plus-chart__point:focus-visible .plus-chart__mark {
		stroke: var(--signal);
		stroke-width: 2.5;
	}
	.plus-chart__point.is-active .plus-chart__plumb {
		stroke: var(--signal);
		stroke-width: 1.2;
		opacity: 1;
	}
	.plus-chart__table-wrap {
		font: 10px/1.5 var(--font-mono);
		color: var(--muted);
	}
	.plus-chart__table-wrap summary {
		cursor: pointer;
		width: fit-content;
	}
	.plus-chart table {
		width: 100%;
		min-width: 500px;
		margin-top: 10px;
		border-collapse: collapse;
		text-align: right;
	}
	.plus-chart caption {
		text-align: left;
		margin-bottom: 6px;
	}
	.plus-chart th,
	.plus-chart td {
		padding: 5px 8px;
		border-bottom: 1px solid var(--line);
	}
	.plus-chart th:first-child {
		text-align: left;
	}
	@media (max-width: 650px) {
		.plus-chart__svg {
			min-width: 540px;
		}
		.plus-chart__scroll-hint {
			display: block;
		}
	}
</style>
