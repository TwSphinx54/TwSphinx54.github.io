---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const { pub } = Astro.props;
const {
	author,
	title,
	booktitle,
	time,
	doi,
	paper,
	code,
	huggingface,
	site,
	abstract,
	venueIcon,
	venueColor,
	venueRank,
	venueLogo,
	semantic_scholar_id,
} = pub;

const slug = title
	.toLowerCase()
	.replace(/\s+/g, "-")
	.replace(/[^a-z0-9\-]/g, "");

const isArxivLink = (url: string) => url.includes("arxiv.org");
---

<article
	class="pub-article group relative w-full border-t border-zinc-200/70 py-5 first:border-t-0 dark:border-zinc-800/70"
>
	<div class="pub-article__grid">
		<div class="pub-article__meta" aria-hidden="true">{time ?? "—"}</div>
		<div class="min-w-0 lg:flex-1">
			<h3 class="text-lg leading-snug font-semibold tracking-tight">{title}</h3>
			<p class="mt-1 text-gray-700 dark:text-gray-300">
				{
					author.map((name: string, index: number) => (
						<>
							<span
								class={
									name.replaceAll("*", "").trim() === "Xu Pan" ? "author-highlight" : undefined
								}
							>
								{name}
							</span>
							{index < author.length - 1 && ", "}
						</>
					))
				}
			</p>
			<div class="mt-2 flex flex-wrap gap-2">
				<span class="pub-badge">
					{
						venueLogo ? (
							<Image
								src={venueLogo}
								alt="Venue logo"
								width={14}
								height={14}
								densities={[1, 2]}
								loading="lazy"
								class="mr-1 inline-block h-[14px] w-[14px] object-contain align-[-0.2em]"
							/>
						) : (
							venueIcon && (
								<Icon
									name={venueIcon}
									width="14"
									height="14"
									class="mr-1 inline-block align-[-0.2em]"
									style={`color: ${venueColor}`}
									aria-hidden="true"
								/>
							)
						)
					}
					{booktitle}
				</span>

				{venueRank && <span class="pub-badge">{venueRank}</span>}

				{semantic_scholar_id && <span data-semantic-scholar-id={semantic_scholar_id} />}
			</div>
			<div class="mt-3 flex flex-wrap gap-2" aria-label="Publication actions">
				{
					abstract && (
						<button
							type="button"
							class="ui-control abstract-btn inline-flex cursor-pointer items-center px-2.5 py-1"
							data-abstract-id={`abstract-${slug}`}
							aria-expanded="false"
						>
							ABSTRACT
							<Icon
								name="lucide:chevron-down"
								class="func-icon chev ml-2 h-3 w-3 transform transition-transform duration-200"
								aria-hidden="true"
							/>
						</button>
					)
				}
				{
					code && (
						<a
							class="ui-control inline-flex items-center px-2.5 py-1"
							href={code}
							target="_blank"
							rel="noopener"
						>
							CODE
						</a>
					)
				}
				{
					huggingface && (
						<a
							class="ui-control inline-flex items-center px-2.5 py-1"
							href={huggingface}
							target="_blank"
							rel="noopener"
						>
							HF
						</a>
					)
				}
				{
					site && (
						<a
							class="ui-control inline-flex items-center px-2.5 py-1"
							href={site}
							target="_blank"
							rel="noopener"
						>
							SITE
						</a>
					)
				}
				{
					doi && (
						<a
							class="ui-control inline-flex items-center px-2.5 py-1"
							href={doi}
							target="_blank"
							rel="noopener"
						>
							DOI
						</a>
					)
				}
				{
					paper && (
						<a
							class="ui-control inline-flex items-center px-2.5 py-1"
							href={paper}
							target="_blank"
							rel="noopener"
						>
							{isArxivLink(paper) ? (
								<>
									<Icon
										name="simple-icons:arxiv"
										width="14"
										height="14"
										class="mr-1 inline-block"
										style="color: #B31B1B"
										aria-hidden="true"
									/>
									ARXIV
								</>
							) : (
								"PAPER"
							)}
						</a>
					)
				}
			</div>
		</div>
	</div>

	{
		abstract && (
			<div
				class="abstract-collapse w-full overflow-hidden transition-[max-height,opacity,margin-top] duration-300 ease-in-out"
				id={`abstract-content-${slug}`}
				style="max-height: 0; opacity: 0; margin-top: 0;"
				data-collapsed="true"
			>
				{abstract}
			</div>
		)
	}
</article>
