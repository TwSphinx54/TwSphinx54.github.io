---
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { projects } from "@/data/projects";
import { siteConfig, type SiteMeta } from "@/site-config";

interface Props {
	meta: SiteMeta;
	projectName: string;
	navItems?: { label: string; href: string }[];
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
	projectName,
	navItems = [
		{ label: "Abstract", href: "#abstract-heading" },
		{ label: "Method", href: "#method-heading" },
		{ label: "Evaluation", href: "#evaluation-heading" },
		{ label: "Results", href: "#results-heading" },
		{ label: "Citation", href: "#citation-heading" },
		{ label: "References", href: "#references-heading" },
	],
} = Astro.props;
---

<html class="project-document scroll-smooth" lang={siteConfig.lang}>
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
		<script is:inline>
			window.MathJax = {
				tex: {
					inlineMath: [
						["$", "$"],
						["\\(", "\\)"],
					],
					displayMath: [
						["$$", "$$"],
						["\\[", "\\]"],
					],
					processEscapes: true,
				},
				options: { skipHtmlTags: ["script", "noscript", "style", "textarea", "pre", "code"] },
			};
		</script>
		<script is:inline async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"
		></script>
	</head>
	<body>
		<ThemeProvider />
		<SkipLink />
		<div class="project-frame">
			<header class="project-sidebar">
				<div class="project-brand">
					<a href="#top" aria-label={`${projectName} — Back to top`}>{projectName}</a>
				</div>
				<nav class="project-nav" aria-label="On this page">
					{navItems.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<div class="project-sidebar__actions">
					<a class="project-sidebar__control" href="/">
						<span aria-hidden="true">←</span>
						<span>Home</span>
					</a>
					<details class="project-works">
						<summary class="project-sidebar__control">
							<span>More Works</span>
							<span class="project-sidebar__chevron" aria-hidden="true"></span>
						</summary>
						<nav class="project-works__menu" aria-label="Project pages">
							{
								projects.map((project) => (
									<a
										href={project.href}
										aria-current={Astro.url.pathname === project.href ? "page" : undefined}
									>
										<>
											<strong>{project.name}</strong>
											<span>{project.venue}</span>
										</>
									</a>
								))
							}
						</nav>
					</details>
					<div class="project-sidebar__theme"><ThemeToggle /></div>
				</div>
			</header>
			<main id="main" class="project-main"><slot /></main>
		</div>
	</body>
</html>

<script>
	const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-bibtex]");
	copyButton?.addEventListener("click", async () => {
		const code = copyButton.parentElement?.querySelector("code")?.textContent ?? "";
		await navigator.clipboard.writeText(code);
		copyButton.textContent = "Copied";
		window.setTimeout(() => (copyButton.textContent = "Copy BibTeX"), 1600);
	});

	document.querySelectorAll<HTMLElement>("[data-sync-table-caption]").forEach((figure) => {
		const table = figure.querySelector<HTMLTableElement>("table");
		const scroller = figure.querySelector<HTMLElement>(".table-scroll");
		const caption = figure.querySelector<HTMLElement>("figcaption");
		if (!table || !scroller || !caption) return;

		const syncCaptionWidth = () => {
			caption.style.inlineSize = `${Math.min(table.getBoundingClientRect().width, scroller.clientWidth)}px`;
			caption.dataset.sized = "true";
		};

		requestAnimationFrame(syncCaptionWidth);
		const observer = new ResizeObserver(syncCaptionWidth);
		observer.observe(table);
		observer.observe(scroller);
	});

	const scrollTimers = new WeakMap<HTMLElement, number>();
	const revealScrollbar = (scroller: HTMLElement) => {
		scroller.classList.add("is-scrolling");
		const previousTimer = scrollTimers.get(scroller);
		if (previousTimer) window.clearTimeout(previousTimer);
		scrollTimers.set(
			scroller,
			window.setTimeout(() => scroller.classList.remove("is-scrolling"), 700),
		);
	};
	document.querySelectorAll<HTMLElement>(".citation pre, .table-scroll").forEach((scroller) => {
		scroller.addEventListener("scroll", () => revealScrollbar(scroller), { passive: true });
	});
	window.addEventListener("scroll", () => revealScrollbar(document.documentElement), {
		passive: true,
	});
</script>

<style is:global>
	.project-frame {
		display: grid;
		grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
		min-height: 100vh;
		padding: 8px var(--outer-rail) 0;
	}
	.project-sidebar {
		position: sticky;
		top: 8px;
		display: flex;
		height: calc(100vh - 8px);
		flex-direction: column;
		padding: clamp(30px, 7vh, 84px) 32px 32px 0;
		border-right: 1px solid var(--line);
	}
	.project-brand a {
		font-family: var(--font-sans);
		font-size: 18px;
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	.project-nav {
		position: absolute;
		top: calc(var(--content-top) + 4.32px);
		left: 0;
		display: grid;
		gap: 0;
		margin: 0;
		font-family: var(--font-sans);
		font-size: 14px;
		line-height: 1;
	}
	.project-nav a {
		padding-bottom: 5px;
	}
	.project-nav a:hover {
		color: var(--signal);
	}
	.project-sidebar__actions {
		display: flex;
		height: 30px;
		align-items: stretch;
		gap: 7px;
		margin-top: auto;
		align-self: flex-end;
	}
	.project-sidebar__control {
		display: flex;
		height: 30px;
		min-height: 30px;
		align-items: center;
		justify-content: center;
		gap: 5px;
		padding: 0 9px;
		border: 1px solid var(--line-strong);
		background: var(--paper);
		font-family: var(--font-mono);
		font-size: 9px;
		cursor: pointer;
		list-style: none;
	}
	.project-sidebar__control::-webkit-details-marker {
		display: none;
	}
	.project-sidebar__control:hover,
	.project-works[open] > summary {
		background: var(--ink);
		color: var(--paper);
	}
	.project-sidebar__chevron {
		width: 5px;
		height: 5px;
		border-right: 1px solid currentColor;
		border-bottom: 1px solid currentColor;
		transform: translateY(-1px) rotate(45deg);
	}
	.project-works[open] .project-sidebar__chevron {
		transform: translateY(1px) rotate(225deg);
	}
	.project-works {
		position: relative;
		height: 30px;
	}
	.project-sidebar__theme {
		display: flex;
		height: 30px;
		align-items: center;
	}
	.project-sidebar__actions .theme-button {
		flex: 0 0 30px;
		align-self: center;
		margin: 0;
	}
	.project-works__menu {
		position: absolute;
		right: 0;
		bottom: calc(100% + 8px);
		z-index: 20;
		display: grid;
		width: 176px;
		border: 1px solid var(--line-strong);
		background: var(--paper);
		box-shadow: 0 12px 32px color-mix(in srgb, var(--ink) 12%, transparent);
	}
	.project-works__menu a {
		display: grid;
		gap: 2px;
		padding: 10px 12px;
		font-family: var(--font-sans);
		font-size: 11px;
	}
	.project-works__menu a + a {
		border-top: 1px solid var(--line);
	}
	.project-works__menu a:hover {
		background: var(--ink);
		color: var(--paper);
	}
	.project-works__menu strong {
		font-weight: 400;
	}
	.project-works__menu span {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 8px;
	}
	.project-main {
		width: 100%;
		min-width: 0;
		padding: var(--content-top) 0 clamp(80px, 10vw, 140px) var(--content-gutter);
	}
	.project-page {
		width: min(100%, 760px);
		margin: 0;
	}
	.project-section {
		width: 100% !important;
		padding: clamp(58px, 6.5vw, 78px) 0 !important;
	}
	.project-section::before {
		display: none;
	}
	.section-label {
		position: relative;
		margin-bottom: 26px;
	}
	.section-label span {
		position: absolute;
		top: 0.48em;
		left: -76px;
		margin: 0;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 9px;
		line-height: 1;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.section-label h2 {
		margin: 0 !important;
		font-family: var(--font-sans);
		font-size: 18px !important;
		font-weight: 400;
		line-height: 1.3;
		letter-spacing: -0.01em;
	}
	.project-document figure {
		margin: 0;
	}
	.project-document .figure-media {
		position: relative;
	}
	.project-document figure img,
	.project-document figure video {
		display: block;
		width: 100%;
		height: auto;
		background: transparent;
	}
	.project-document figure img {
		mix-blend-mode: multiply;
	}
	.project-document:is(.dark, [data-theme="dark"]) figure img {
		background: white;
		mix-blend-mode: normal;
	}
	:is(.project-abstract, .project-copy) {
		max-width: var(--reading-width);
		margin: 0;
		font-family: var(--font-serif);
		font-size: 13px;
		line-height: 1.65;
	}
	.paper-table-figure {
		width: max-content;
		max-width: 100%;
	}
	.table-caption {
		visibility: hidden;
		inline-size: 0;
		max-inline-size: 100%;
	}
	.table-caption[data-sized] {
		visibility: visible;
	}
	.table-scroll {
		width: fit-content;
		max-width: 100%;
		overflow-x: auto;
		overscroll-behavior-inline: contain;
	}
	.paper-table {
		width: max-content;
		border-collapse: collapse;
		border-block: 1px solid var(--ink);
		font-family: var(--font-sans);
		font-size: 10px;
		font-variant-numeric: tabular-nums;
		line-height: 1.4;
		text-align: right;
	}
	.paper-table :is(th, td) {
		padding: 10px 8px;
		white-space: nowrap;
	}
	.paper-table thead th {
		border-bottom: 1px solid var(--line-strong);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 9px;
		font-weight: 400;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.paper-table :is(th, td):first-child {
		text-align: left;
	}
	.paper-table th:first-child {
		background: var(--paper);
		color: var(--ink);
	}
	.paper-table tbody tr + tr {
		border-top: 1px solid var(--line);
	}
	.paper-table tbody :is(th, td):hover {
		background: color-mix(in srgb, var(--ink) 7%, var(--paper));
		color: var(--ink);
	}
	.paper-table :is(.ours, .paper-table__ours) {
		background: color-mix(in srgb, var(--signal) 6%, transparent);
	}
	.paper-table :is(.ours, .paper-table__ours) th:first-child {
		background: color-mix(in srgb, var(--signal) 6%, var(--paper));
	}
	.paper-table tbody tr:is(.ours, .paper-table__ours) > :is(th, td):hover,
	.paper-table td:has(:is(strong, u)):hover {
		background: color-mix(in srgb, var(--signal) 14%, var(--paper)) !important;
	}
	.paper-table thead th:hover,
	.paper-table tbody :is(th, td):first-child:hover {
		background: var(--paper) !important;
	}
	.paper-table tbody tr:is(.ours, .paper-table__ours) > :first-child:hover {
		background: color-mix(in srgb, var(--signal) 6%, var(--paper)) !important;
	}
	.citation {
		position: relative;
		margin-left: 0;
	}
	.citation pre {
		margin: 0;
		overflow-x: auto;
		padding: 24px;
		border: 1px solid var(--line);
		background: color-mix(in srgb, var(--ink) 4%, transparent);
		font-family: var(--font-mono);
		font-size: 10px;
		line-height: 1.7;
		white-space: pre;
	}
	.copy-button {
		position: absolute;
		top: 0;
		right: 0;
		min-height: 32px;
		padding: 0 11px;
		border: 0;
		background: var(--ink);
		color: var(--paper);
		font-family: var(--font-mono);
		font-size: 9px;
		cursor: pointer;
	}
	.copy-button:hover {
		background: var(--signal);
	}
	.references-list {
		max-width: var(--reading-width);
		margin: 0;
		padding: 0;
		counter-reset: references;
		font-size: 11px;
		line-height: 1.6;
		list-style: none;
	}
	.references-list li {
		position: relative;
		padding-left: 28px;
		counter-increment: references;
	}
	.references-list li + li {
		margin-top: 10px;
	}
	.references-list li::before {
		position: absolute;
		top: 0.18em;
		left: 0;
		content: "[" counter(references) "]";
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 9px;
	}
	.references-list li > a {
		margin-left: 4px;
	}
	.citation-mark {
		margin-left: 2px;
		font-family: var(--font-mono);
		font-size: 8px;
	}
	:is(.references-list, .citation-mark) a {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 3px;
	}
	:is(.references-list, .citation-mark) a:hover {
		color: var(--signal);
		text-decoration-color: var(--signal);
	}
	.project-document,
	.project-frame :is(.citation pre, .table-scroll) {
		scrollbar-color: transparent transparent;
		scrollbar-gutter: stable;
		scrollbar-width: thin;
	}
	.project-document::-webkit-scrollbar,
	.project-frame :is(.citation pre, .table-scroll)::-webkit-scrollbar {
		width: 6px;
		height: 6px;
	}
	.project-document::-webkit-scrollbar-track,
	.project-frame :is(.citation pre, .table-scroll)::-webkit-scrollbar-track {
		border-radius: 0;
		background: transparent;
	}
	.project-document::-webkit-scrollbar-thumb,
	.project-frame :is(.citation pre, .table-scroll)::-webkit-scrollbar-thumb {
		border-radius: 0;
		background: transparent;
	}
	.project-document::-webkit-scrollbar-corner,
	.project-frame :is(.citation pre, .table-scroll)::-webkit-scrollbar-corner {
		border-radius: 0;
		background: transparent;
	}
	.project-document.is-scrolling,
	.project-frame
		:is(.citation pre, .table-scroll):is(:hover, :focus, :focus-within, .is-scrolling) {
		scrollbar-color: var(--line-strong) transparent;
	}
	.project-document.is-scrolling::-webkit-scrollbar-thumb,
	.project-frame
		:is(.citation pre, .table-scroll):is(
			:hover,
			:focus,
			:focus-within,
			.is-scrolling
		)::-webkit-scrollbar-thumb {
		background: var(--line-strong);
	}
	.project-frame .project-nav {
		-ms-overflow-style: none;
		scrollbar-gutter: auto !important;
		scrollbar-width: none !important;
	}
	.project-frame .project-nav::-webkit-scrollbar {
		display: none;
		width: 0;
		height: 0;
	}
	.project-frame .table-scroll table :is(th, td):first-child {
		position: sticky;
		left: 0;
		z-index: 1;
		background: var(--paper);
		background-clip: padding-box;
	}
	.project-frame .table-scroll table thead :is(th, td):first-child {
		z-index: 2;
	}
	.project-frame
		.table-scroll
		table
		tbody
		tr:is(.ours, .paper-table__ours)
		> :is(th, td):first-child {
		background: color-mix(in srgb, var(--signal) 6%, var(--paper));
	}
	@media (max-width: 1024px) {
		.project-frame {
			display: block;
			padding: 0 18px;
		}
		.project-sidebar {
			position: relative;
			top: auto;
			height: auto;
			display: grid;
			grid-template-columns: 1fr auto;
			gap: 24px 12px;
			padding: 24px 0 18px;
			border-right: 0;
			border-bottom: 1px solid var(--line);
		}
		.project-nav {
			position: static;
			grid-column: 1 / -1;
			display: flex;
			gap: 18px;
			margin: 0;
			overflow-x: auto;
			font-size: 12px;
		}
		.project-nav a {
			white-space: nowrap;
		}
		.project-sidebar__actions {
			grid-column: 2;
			grid-row: 1;
			margin: 0;
			align-self: start;
		}
		.project-works__menu {
			top: calc(100% + 8px);
			bottom: auto;
		}
		.project-main {
			padding: 54px 0 80px;
		}
		.project-page,
		.project-section {
			width: 100% !important;
			max-width: none;
			min-width: 0;
		}
		.section-label {
			padding-right: 34px;
		}
		.section-label span {
			right: 0;
			left: auto;
		}
		.citation {
			width: 100%;
			max-width: none;
			min-width: 0;
			margin-inline: 0;
		}
		.citation pre {
			max-width: 100%;
		}
		.project-frame
			:is(.paper-table-figure, .result-table-figure, .main-results-table, .evaluation-tables) {
			width: 100% !important;
			max-width: 100% !important;
			min-width: 0 !important;
		}
		.project-frame .table-scroll {
			width: 100% !important;
			max-width: 100% !important;
			min-width: 0 !important;
		}
	}
	@media (max-width: 560px) {
		.citation pre {
			padding: 54px 16px 18px;
		}
	}
</style>
