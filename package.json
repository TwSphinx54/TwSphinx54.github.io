{
	"name": "twsphinx54",
	"version": "4.11.0",
	"private": true,
	"description": "Xu Pan's personal academic portfolio and creative archive.",
	"license": "MIT",
	"homepage": "https://xupan.top",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TwSphinx54/TwSphinx54.github.io.git"
	},
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=11.0.0 <12.0.0"
	},
	"packageManager": "pnpm@11.20.0",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"social-cards": "node scripts/generate-social-cards.mjs",
		"normalize-icons": "node scripts/normalize-tool-icons.mjs",
		"preview": "astro preview",
		"lint": "biome check . && prettier --check \"src/**/*.astro\" \"README.md\"",
		"format": "biome check --write . && prettier --write \"src/**/*.astro\" \"README.md\"",
		"check": "astro check",
		"validate": "pnpm run lint && pnpm run check && pnpm run build"
	},
	"dependencies": {
		"astro": "^7.4.1",
		"astro-icon": "^1.2.0",
		"astro-robots-txt": "^1.0.0",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.11",
		"@biomejs/biome": "^2.5.15",
		"@iconify-json/lucide": "^1.2.146",
		"@iconify-json/simple-icons": "^1.2.100",
		"@tailwindcss/vite": "^4.3.3",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	}
}
